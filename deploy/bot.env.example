# Model for /etc/vagas-bot/bot.env (systemd EnvironmentFile).
# Format: KEY=value, no "export", no quotes. File mode 600, owner deploy.

# Telegram bot token (secret)
TELEGRAM_TOKEN=
# Telegram group that receives the jobs and alerts
CHAT_ID_GRUPO=
# Brave Search API key (secret); goes out direct, not through WARP
BRAVE_API_KEY=
# li_at cookie of the logged-in LinkedIn session (secret). Empty: the bot falls back to Brave
LINKEDIN_LI_AT=
# PocketBase on this same VPS
PB_URL=http://127.0.0.1:8093
# PocketBase robot user
PB_BOT_EMAIL=
# PocketBase robot password (secret)
PB_BOT_PASSWORD=
# WARP local SOCKS proxy: every job site goes through it
SCRAPER_PROXY=socks5h://127.0.0.1:40000
# true: without a working proxy no source runs, so no job site sees the VPS's own IP
REQUIRE_SCRAPER_PROXY=true
# Claude API key (secret); used only by the weekly job analysis (analyze_descriptions.py)
ANTHROPIC_API_KEY=
# Resume .tex compared with the jobs; must be readable by the deploy user. Empty: report without the resume comparison
RESUME_PATH=
