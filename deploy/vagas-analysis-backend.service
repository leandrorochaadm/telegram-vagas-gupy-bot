# Weekly analysis of the saved back-end job descriptions (analyze_descriptions.py --track backend).
# Failures are alerted by the script itself, so there is no OnFailure=.
# After= the Flutter and mobile units: when the timers fire together (Persistent= catch-up at boot), the
# back-end run waits for both, so no two runs write the shared cache files at the same time.
[Unit]
Description=Weekly analysis of the back-end job descriptions
Wants=network-online.target
After=network-online.target pocketbase-job-search.service vagas-analysis.service vagas-analysis-mobile.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/vagas-bot/app
EnvironmentFile=/etc/vagas-bot/bot.env
Environment=PATH=/home/deploy/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/deploy/.local/bin/uv run --script analyze_descriptions.py --track backend
TimeoutStartSec=30min
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
