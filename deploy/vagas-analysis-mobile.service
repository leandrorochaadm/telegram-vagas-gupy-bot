# Weekly analysis of the saved mobile job descriptions (analyze_descriptions.py --track mobile).
# Failures are alerted by the script itself, so there is no OnFailure=.
# After= vagas-analysis.service: when both timers fire together (Persistent= catch-up at boot), the
# mobile run waits for the Flutter one, so the two never write the shared cache files at the same time.
[Unit]
Description=Weekly analysis of the mobile job descriptions
Wants=network-online.target
After=network-online.target pocketbase-job-search.service vagas-analysis.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/vagas-bot/app
EnvironmentFile=/etc/vagas-bot/bot.env
Environment=PATH=/home/deploy/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/deploy/.local/bin/uv run --script analyze_descriptions.py --track mobile
TimeoutStartSec=30min
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
